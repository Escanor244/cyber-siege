# Cyber Siege - Environment Variables
# Copy this file to .env.local for local development, or set these in your Vercel Project Settings

# Live Cloudflare PartyServer domain (e.g. cyber-siege.<your-subdomain>.workers.dev)
# For local testing, you can leave this blank (defaults to localhost:1999)
VITE_PARTYKIT_HOST=cyber-siege.your-subdomain.workers.dev
